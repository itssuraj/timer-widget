<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_outer_bg"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp"
    android:paddingTop="0dp">

    <!-- Header: Timer + Add Button -->
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingStart="12dp"
        android:paddingEnd="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Timer"
            android:textColor="#B3FEF7FF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/btn_add_timer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:contentDescription="Add Timer"
            android:src="@drawable/ic_add"
            android:tint="#B3FEF7FF" />
    </RelativeLayout>

    <!-- Primary Timer Container (Slot 1) -->
    <FrameLayout
        android:id="@+id/primary_timer_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_bg_idle">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/primary_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="10m"
                android:textColor="#B3FEF7FF"
                android:textSize="28sp"
                android:fontFamily="sans-serif" />

            <!-- Reset/Restart Icon for Primary Timer -->
            <ImageView
                android:id="@+id/primary_timer_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:padding="6dp"
                android:contentDescription="Reset"
                android:src="@drawable/ic_reset"
                android:tint="#B3FEF7FF"
                android:visibility="gone" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Secondary Timer Container (Slot 2) -->
    <FrameLayout
        android:id="@+id/secondary_timer_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_idle"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/secondary_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="5m"
                android:textColor="#B3FEF7FF"
                android:textSize="28sp"
                android:fontFamily="sans-serif" />

            <!-- Reset/Restart Icon for Secondary Timer -->
            <ImageView
                android:id="@+id/secondary_timer_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:padding="6dp"
                android:contentDescription="Reset"
                android:src="@drawable/ic_reset"
                android:tint="#B3FEF7FF"
                android:visibility="gone" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No timers set"
        android:textColor="#B3FEF7FF"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
